NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://game_consign:game_consign_dev@postgres:5432/game_consign
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_LOCK_TIMEOUT_MS=2000

REDIS_URL=redis://redis:6379

# Development-only value. Generate a random production secret in a secret manager.
WEBHOOK_HMAC_SECRET=dev-only-change-me-at-least-32-characters
AUDIT_HMAC_SECRET=dev-only-audit-key-change-me-32-chars

# Comma-separated exact origins. Never use wildcard for credentialed requests.
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
TRUST_PROXY=false

ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=1209600
WEBHOOK_TOLERANCE_SECONDS=300
MAX_BODY_BYTES=1048576

# Seed credentials are only read when NODE_ENV is not production.
SEED_BUYER_EMAIL=buyer@example.test
SEED_BUYER_PASSWORD=Buyer-Test-Password-2026!
SEED_SELLER_EMAIL=seller@example.test
SEED_SELLER_PASSWORD=Seller-Test-Password-2026!
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=Admin-Test-Password-2026!
